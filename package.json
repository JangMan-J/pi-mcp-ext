{
  "name": "@jangmanj/pi-mcp-ext",
  "version": "0.2.0",
  "description": "MCP 2026-07-28 events and tasks for Pi, alongside builtin:mcp",
  "license": "MIT",
  "author": "JangMan-J",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JangMan-J/pi-mcp-ext.git"
  },
  "homepage": "https://github.com/JangMan-J/pi-mcp-ext#readme",
  "bugs": {
    "url": "https://github.com/JangMan-J/pi-mcp-ext/issues"
  },
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "src",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "init-package": "node scripts/init-package.mjs",
    "bootstrap:npm": "bash scripts/npm-bootstrap.sh"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": ">=1.5.2",
    "typebox": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@types/node": "~22.19.0",
    "typebox": "1.3.27",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
